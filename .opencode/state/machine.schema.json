{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://keystone.dev/schemas/machine.schema.json",
  "title": "Keystone 多智能体状态机配置 Schema v3.0.0",
  "description": "定义契约哈希、任务生命周期、五维状态追踪（type/dep/format/write/security）+ 双防线强制约束",
  "type": "object",
  "required": ["meta", "contracts", "taskLifecycle"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "project"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "语义化版本号" },
        "project": { "type": "string" },
        "description": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "feature_flags": {
      "type": "object",
      "description": "v3.0 渐进启用开关",
      "properties": {
        "write_time_audit": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "commit_time_audit": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "severity_overrides": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "forbiddenDependencies": {
      "type": "array",
      "description": "v3.0 架构边界规则定义",
      "items": {
        "type": "object",
        "required": ["id", "severity", "description", "from", "to"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warn"] },
          "description": { "type": "string" },
          "from": { "type": "object", "properties": { "path": { "type": "string" }, "pathNot": { "type": "string" }, "fromNot": { "type": "string" } } },
          "to": { "type": "object", "properties": { "path": { "type": "string" }, "pathNot": { "type": "string" } } }
        }
      }
    },
    "write_audit_state": { "type": "object", "description": "v3.0 Write-Time 审计追踪" },
    "type_check_state": {
      "type": "object",
      "description": "v3.0 TypeScript 类型检查状态",
      "properties": {
        "last_incremental_check": { "type": ["string", "null"], "format": "date-time" },
        "last_full_check": { "type": ["string", "null"], "format": "date-time" },
        "incremental_errors": { "type": "integer", "minimum": 0 },
        "full_errors": { "type": "integer", "minimum": 0 },
        "dirty_files": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["clean", "dirty"] },
        "strict_mode": { "type": "boolean" }
      }
    },
    "dependency_state": {
      "type": "object",
      "description": "v3.0 dependency-cruiser 架构边界状态",
      "properties": {
        "last_check": { "type": ["string", "null"] },
        "violations": { "type": "array", "items": { "type": "object" } },
        "status": { "type": "string", "enum": ["clean", "dirty"] },
        "forbidden_rules_applied": { "type": "integer" }
      }
    },
    "format_state": {
      "type": "object",
      "description": "v3.0 Prettier 格式化状态",
      "properties": {
        "last_check": { "type": ["string", "null"] },
        "unformatted_files": { "type": "array", "items": { "type": "string" } },
        "auto_fix_count": { "type": "integer" },
        "status": { "type": "string", "enum": ["clean", "dirty"] }
      }
    },
    "currentTask": { "type": "object", "properties": {
      "id": { "type": "string" }, "title": { "type": "string" }, "status": { "type": "string" }, "owner": { "type": "string", "pattern": "^@[A-Za-z-]+$" }
    }},
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["file", "hash", "owner"],
        "properties": {
          "file": { "type": "string" },
          "hash": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
          "lastValidated": { "type": "string", "format": "date-time" },
          "owner": { "type": "string", "pattern": "^@[A-Za-z-]+$" },
          "description": { "type": "string" }
        }
      }
    },
    "stateTransitions": { "type": "object" },
    "taskLifecycle": {
      "type": "object",
      "required": ["states", "transitions"],
      "properties": {
        "taskTypes": { "type": "array", "items": { "type": "string" } },
        "states": { "type": "array", "items": { "type": "string" } },
        "taskStateFilePattern": { "type": "string", "default": "Task.DAG.json" },
        "transitions": { "type": "array", "items": {
          "type": "object", "required": ["from", "to"],
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" },
            "requiredEvidence": { "type": "array", "items": {
              "type": "object", "required": ["filePattern"],
              "properties": {
                "filePattern": { "type": "string" },
                "description": { "type": "string" },
                "schema": { "type": "object" },
                "contentMustContain": { "type": "string" },
                "contentMustNotContain": { "type": "string" }
              }
            }}
          }
        }}
      }
    },
    "eslint_state": {
      "type": "object",
      "properties": {
        "last_full_scan": { "type": ["string", "null"] },
        "modules": { "type": "object" },
        "aggregate": {
          "type": "object",
          "properties": {
            "total_violations": { "type": "integer" },
            "dirty_modules": { "type": "array", "items": { "type": "string" } },
            "waived_modules": { "type": "array", "items": { "type": "string" } },
            "mock_violations": { "type": "integer" },
            "quality_violations": { "type": "integer" },
            "bogus_test_patterns": { "type": "integer" },
            "skipped_checks": { "type": "integer" }
          }
        }
      }
    },
    "mutation_state": { "type": "object", "description": "v3.0 Stryker 变异测试" },
    "security_state": { "type": "object", "description": "v3.0 Snyk 依赖安全" },
    "contract_compliance": { "type": "object" },
    "waivers_consumed": { "type": "array" },
    "compliance_records": {
      "type": "object",
      "properties": {
        "role_violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "agent", "violation_file", "status"],
            "properties": {
              "timestamp": { "type": "string", "format": "date-time" },
              "agent": { "type": "string", "pattern": "^@[A-Za-z-]+$" },
              "violation_file": { "type": "string" },
              "status": { "type": "string", "enum": ["unresolved", "resolved"] },
              "severity": { "type": "string" }
            }
          }
        }
      }
    },
    "auditLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "agent", "action", "target", "details"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "agent": { "type": "string", "pattern": "^@[A-Za-z-]+$" },
          "action": { "type": "string", "enum": ["INITIALIZE","UPDATE","HASH_CORRECTION","HASH_UPDATE","SCHEMA_UPGRADE","TDD_PHASE_TRANSITION"] },
          "target": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    }
  }
}
