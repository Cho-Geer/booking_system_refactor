# Frontend Environment Configuration
# Copy this file to .env and update with your values
# Note: Angular uses environment.ts files, but these variables can be
# used with ngx-env or similar plugins for runtime configuration

# API Configuration
# Backend API base URL (relative path for dev proxy, absolute for production)
FRONTEND_API_URL=/api

# WebSocket Server URL
FRONTEND_SOCKET_URL=http://localhost:3001

# Backend API URL for production (when not using proxy)
# FRONTEND_API_URL_PROD=https://api.yourdomain.com/v1

# Feature Flags
# Enable debug mode (development only)
# FRONTEND_DEBUG=true

# Enable performance monitoring
# FRONTEND_ENABLE_PERF_MONITORING=false

# Lighthouse CI Configuration
# See lighthouserc.json for performance budgets
